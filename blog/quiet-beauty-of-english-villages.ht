<script>
  // Wikipedia image hydration
  var wikiCache = {};
  function fetchWikiImage(title, px){
    if (wikiCache[title]) return wikiCache[title];
    var p = fetch("https://en.wikipedia.org/w/api.php?action=query&titles=" + encodeURIComponent(title) +
      "&prop=pageimages&format=json&pithumbsize=" + (px || 1600) + "&redirects=1&origin=*")
      .then(function(r){ return r.json(); })
      .then(function(data){
        var pages = data.query && data.query.pages;
        if (!pages) return null;
        var page = pages[Object.keys(pages)[0]];
        return (page && page.thumbnail && page.thumbnail.source) || null;
      })
      .catch(function(){ return null; });
    wikiCache[title] = p;
    return p;
  }
  document.querySelectorAll("[data-wiki]").forEach(function(node){
    var title = node.getAttribute("data-wiki");
    var img = node.querySelector("img");
    if (!img) return;
    fetchWikiImage(title, node.hasAttribute("data-eager") ? 1600 : 900).then(function(url){
      if (!url) return;
      img.src = url;
      img.onload = function(){ img.classList.add("loaded"); };
    });
  });
</script>
